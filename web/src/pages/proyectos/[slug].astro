---
import SiteLayout from '../../layouts/SiteLayout.astro';import ProductCard from '../../components/ProductCard.astro';import Gallery from '../../components/Gallery.astro';import {project} from '../../server/db';const p=project(Astro.params.slug!);if(!p)Astro.response.status=404;
---
<SiteLayout title={p?.name||'Proyecto no disponible'}>{p?<section class="section project-detail"><nav class="breadcrumbs"><a href="/proyectos">Proyectos</a><span>/</span><span>{p.name}</span></nav><div class="project-title"><div><p class="eyebrow">{p.city} · {p.sector}</p><h1>{p.name}</h1><p class="sku">Referencia: {p.sku}</p></div><p>{p.description}</p></div><Gallery images={p.images} name={p.name}/><div class="section-heading"><div><p class="eyebrow">DEL ESPACIO A TU PROYECTO</p><h2>Los materiales <em>de este ambiente.</em></h2></div><p>Encuentra tu favorito y consulta con nosotros.</p></div><div class="product-grid home-products">{p.products.map((product:any)=><ProductCard p={product}/>)}</div>{!p.products.length&&<p>Consulta con nuestro equipo los materiales disponibles para un espacio como este.</p>}</section>:<section class="section empty-state"><h1>Este proyecto no está disponible.</h1><a class="button primary" href="/catalogo">Explorar materiales</a></section>}</SiteLayout>
