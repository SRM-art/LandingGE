---
import SiteLayout from '../../layouts/SiteLayout.astro';import ProjectCard from '../../components/ProjectCard.astro';import {projects,options} from '../../server/db';const o=(await options());const q=Astro.url.searchParams;const published=(await projects());const cities=[...new Map(published.map(p=>[p.city_id,p.city])).entries()].sort((a,b)=>a[1].localeCompare(b[1],'es-CO'));const rows=published.filter(p=>(!q.get('city')||String(p.city_id)===q.get('city'))&&(!q.get('sector')||String(p.sector_id)===q.get('sector')));
---
<SiteLayout title="Proyectos"><section class="page-intro"><p class="eyebrow">ESPACIOS QUE INSPIRAN</p><h1>Ideas que toman forma.<br/><em>Detalles que permanecen.</em></h1><p>Descubre los ambientes y los materiales que los hacen posibles.</p></section><section class="section"><form class="project-filters" action="/proyectos"><label>Ciudad<select name="city"><option value="">Todas las ciudades</option>{cities.map(([id,name])=><option value={id} selected={q.get('city')===String(id)}>{name}</option>)}</select></label><label>Sector<select name="sector"><option value="">Todos los sectores</option>{o.sectors.map(s=><option value={s.id} selected={q.get('sector')===String(s.id)}>{s.name}</option>)}</select></label><button class="button primary">Filtrar proyectos</button><a href="/proyectos">Limpiar</a><span>{rows.length} proyectos</span></form><div class="project-grid">{rows.map(p=><ProjectCard p={p}/>)}</div>{!rows.length&&<div class="empty-state"><h2>No hay proyectos con esos filtros.</h2><a href="/proyectos">Ver todos</a></div>}</section></SiteLayout>
