---
import AccessLayout from '../../layouts/AccessLayout.astro';import {localMessages,localMailEnabled} from '../../server/local-mail';import {hash} from '../../server/auth';import {one} from '../../server/db';
if(!localMailEnabled())return new Response('No encontrado.',{status:404});
const messages=localMessages().map(m=>({...m,valid:m.token&&!!one(`SELECT 1 FROM auth_token t JOIN auth_user u ON u.id=t.user_id WHERE t.token_hash=? AND t.expires_at>? AND t.used_at IS NULL AND t.revoked_at IS NULL AND t.security_version=u.security_version AND u.state!='disabled'`,hash(m.token),Date.now())}));
const titles:Record<string,string>={invite:'Invitación al equipo',reset:'Recuperar contraseña',email:'Confirmar nuevo correo',notice:'Aviso de seguridad'};
const paths:Record<string,string>={invite:'/admin/activar',reset:'/admin/restablecer',email:'/admin/confirmar-correo'};
---
<AccessLayout title="Buzón de prueba"><h1>Correo local.</h1><p>Simulación de los mensajes enviados. Solo para revisión en este equipo: quien pueda abrir este buzón puede usar sus enlaces de acceso.</p><div class="mail-actions"><a class="text-link" href="/admin/correo-local">Actualizar buzón</a><a class="text-link" href="/admin">Volver al panel</a></div><div class="local-messages">{messages.length?messages.map(m=><article class="mail-card"><span class="eyebrow">{titles[m.purpose]||'Mensaje'}</span><strong>{m.to}</strong><small>{new Date(m.createdAt||0).toLocaleString('es-CO')}</small>{m.text&&<p>{m.text}</p>}{m.token&&(m.valid?<a class="button outline" href={`${paths[m.purpose]}?token=${m.token}`}>Abrir enlace →</a>:<span class="hint">Enlace usado, reemplazado o vencido.</span>)}</article>):<div class="notice">Aún no hay mensajes. Invita a un usuario o solicita recuperar tu contraseña.</div>}</div></AccessLayout>
