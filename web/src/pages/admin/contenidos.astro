---
import CarouselTextField from '../../components/CarouselTextField.astro';import AdminLayout from '../../layouts/AdminLayout.astro';import CustomSlides from '../../components/CustomSlides.astro';import ImageEditor from '../../components/ImageEditor.astro';import {settings,all} from '../../server/db';const s=settings();const slides=all('SELECT * FROM slide WHERE id<=3 ORDER BY position');const services=all('SELECT * FROM service ORDER BY position');
---
<AdminLayout title="Inicio y contacto"><div class="admin-heading"><div><p class="eyebrow">TU MARCA, TU CONTENIDO</p><h1>Inicio y contacto</h1><p>Actualiza el contenido conservando el diseño y los colores del sitio.</p></div><a href="/" target="_blank" class="button outline">Ver inicio ↗</a></div><form data-content-form data-revision={s.revision}><section class="panel"><h2>Datos de contacto</h2><div class="field-pair"><label>WhatsApp (código de país + número)<input name="whatsapp" value={s.whatsapp} placeholder="Ej. 573001234567" pattern="[1-9][0-9]{7,14}"/><small>Solo dígitos. Si está vacío, se mostrará una vista previa del mensaje.</small></label><label>Teléfono visible<input name="phone" value={s.phone} maxlength="50"/></label><label>Correo electrónico<input name="email" type="email" value={s.email}/></label><label>Dirección<input name="address" value={s.address} maxlength="250"/></label></div><label>Horario de atención<input name="hours" value={s.hours} maxlength="150"/></label></section><section class="panel"><h2>Carrusel principal</h2><p class="hint">Tres diapositivas base permanentes. Puedes editar su contenido; se conservan siempre en el carrusel. El avance es automático cada 9 segundos. En pantallas táctiles se puede deslizar; en escritorio se puede retroceder o avanzar con las flechas.</p>{slides.map(slide=><fieldset class="content-slide" data-slide-editor data-slide-id={slide.id}><div><h3>Diapositiva {slide.id}</h3><span class="badge published">Base · permanente</span></div><div class="content-slide-grid"><div><CarouselTextField field="title" name={'slide_'+slide.id+'_title'} value={slide.title}/><CarouselTextField field="subtitle" name={'slide_'+slide.id+'_subtitle'} value={slide.subtitle}/><CarouselTextField field="description" name={'slide_'+slide.id+'_description'} value={slide.description}/><div class="field-pair"><CarouselTextField field="button_text" name={'slide_'+slide.id+'_button_text'} value={slide.button_text}/><label>Destino<select name={'slide_'+slide.id+'_button_href'}>{[['/catalogo','Catálogo'],['/proyectos','Proyectos'],['/#servicios','Servicios'],['/#contacto','Contacto']].map(([href,label])=><option value={href} selected={href===slide.button_href}>{label}</option>)}</select></label></div></div><ImageEditor images={[{id:slide.media_id}]} single field={'slide_'+slide.id+'_image'}/></div></fieldset>)}</section><section class="panel"><h2>Servicios</h2><div class="field-triple">{services.map(service=><fieldset data-service-editor data-service-id={service.id}><label>Título<input name={'service_'+service.id+'_title'} value={service.title} required maxlength="80"/></label><label>Descripción<textarea name={'service_'+service.id+'_description'} maxlength="500">{service.description}</textarea></label></fieldset>)}</div></section><section class="panel"><h2>Acerca de Gestión Esencial</h2><div class="content-slide-grid"><div><label>Título<input name="about_title" value={s.about_title} required maxlength="200"/></label><label>Descripción<textarea name="about_text" rows="8" maxlength="6000">{s.about_text}</textarea></label></div><ImageEditor images={s.about_media_id?[{id:s.about_media_id}]:[]} field="about_image" single/></div></section><div class="content-save"><button class="button primary" data-save>Guardar contenidos</button><p class="form-status" data-form-status role="status"></p></div></form><CustomSlides/></AdminLayout>



