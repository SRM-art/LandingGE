---
import {production} from "#runtime";
import AccessLayout from '../../layouts/AccessLayout.astro';import PasswordField from '../../components/PasswordField.astro';import {ownerExists} from '../../server/auth';
if((await ownerExists()))return Astro.redirect('/admin/login');
---
<AccessLayout title="Configurar propietario"><h1>Tu administración empieza aquí.</h1><p>Crea la cuenta del propietario para revisar el panel. Esta configuración se realiza una sola vez.</p><form data-auth-form="setup" class="account-form"><label>Correo del propietario<input type="email" name="email" autocomplete="username" maxlength="254" required/></label>{production&&<label>Código de configuración<input type="password" name="setupToken" autocomplete="off" required/></label>}<PasswordField fresh/><PasswordField name="confirmation" label="Confirmar contraseña" fresh/><div class="form-actions"><button class="button primary" type="submit">Crear cuenta e ingresar →</button><a class="button outline" href="/">Cancelar</a></div><p data-auth-status class="form-status" role="status"></p></form></AccessLayout>
