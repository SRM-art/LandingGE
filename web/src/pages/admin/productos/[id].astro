---
import AdminLayout from '../../../layouts/AdminLayout.astro';import RecordEditor from '../../../components/RecordEditor.astro';import {product} from '../../../server/db';const isNew=Astro.params.id==='nuevo';const p=isNew?null:product(Astro.params.id!,true);if(!isNew&&!p)return Astro.redirect('/admin/productos');
---
<AdminLayout title={p?.name||'Agregar producto'}><RecordEditor kind="product" p={p}/></AdminLayout>
