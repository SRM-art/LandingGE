---
import AdminLayout from '../../layouts/AdminLayout.astro';import {all,one,settings} from '../../server/db';const stats=one("SELECT (SELECT count(*) FROM product WHERE deleted_at IS NULL) products,(SELECT count(*) FROM product WHERE deleted_at IS NULL AND state='published') published,(SELECT count(*) FROM project WHERE deleted_at IS NULL) projects,(SELECT count(*) FROM product WHERE deleted_at IS NOT NULL)+(SELECT count(*) FROM project WHERE deleted_at IS NOT NULL) hidden");const events=all('SELECT * FROM audit ORDER BY created_at DESC LIMIT 8');const s=settings();
---
<AdminLayout title="Resumen"><div class="admin-heading"><div><p class="eyebrow">TU ESPACIO DE TRABAJO</p><h1>Bienvenido a Gestión Esencial.</h1><p>El catálogo, los proyectos y tu marca, en un solo lugar.</p></div></div>{!s.whatsapp&&<div class="notice"><strong>Falta conectar WhatsApp.</strong><span>Configura el número para que los clientes puedan iniciar una conversación.</span><a href="/admin/contenidos">Configurar contacto →</a></div>}<div class="stat-grid">{[['Productos',stats.products],['Publicados',stats.published],['Proyectos',stats.projects],['Ocultos',stats.hidden]].map(([label,value])=><div><span>{label}</span><strong>{value}</strong></div>)}</div><div class="admin-grid"><section class="panel"><h2>¿Qué quieres hacer hoy?</h2><div class="quick-links"><a href="/admin/productos/nuevo"><strong>Agregar un producto</strong><span>Fotos, precio y ficha técnica →</span></a><a href="/admin/proyectos/nuevo"><strong>Agregar un proyecto</strong><span>Espacios y materiales utilizados →</span></a><a href="/admin/contenidos"><strong>Actualizar la página de inicio</strong><span>Carrusel, servicios y contacto →</span></a></div></section><section class="panel"><h2>Actividad reciente</h2>{events.length?events.map(e=><div class="activity"><strong>{e.detail}</strong><span>{e.action} · {new Date(e.created_at).toLocaleString('es-CO')}</span></div>):<p class="empty-admin">Tus cambios aparecerán aquí.</p>}</section></div><p class="hint">Los registros ocultos se conservan y pueden restaurarse como borradores. No hay eliminación definitiva.</p></AdminLayout>
