---
import AdminLayout from '../../layouts/AdminLayout.astro';import SessionList from '../../components/SessionList.astro';import PasswordField from '../../components/PasswordField.astro';
const user=Astro.locals.user!;
---
<AdminLayout title="Mi cuenta"><div class="admin-heading"><div><p class="eyebrow">TU SEGURIDAD</p><h1>Mi cuenta.</h1><p>{user.email} · {user.role==='owner'?'Propietario':'Administrador'}</p></div><a class="button outline" href="/admin/correo-local">Buzón de prueba ↗</a></div><SessionList userId={user.id}/><div class="admin-grid"><section class="panel"><h2>Cambiar contraseña</h2><p class="hint">Al guardarla, se cerrarán todas tus sesiones, incluida esta.</p><form data-auth-form="password" class="account-form"><PasswordField name="currentPassword" id="change-current" label="Contraseña actual"/><PasswordField fresh id="change-new" label="Nueva contraseña"/><PasswordField fresh name="confirmation" id="change-confirm" label="Confirmar nueva contraseña"/><button type="submit" class="button primary">Guardar contraseña</button><p data-auth-status class="form-status" role="status"></p></form></section><section class="panel"><h2>Cambiar correo</h2><p class="hint">Confirma el nuevo correo mediante un enlace. Hasta entonces seguirá vigente el actual.</p><form data-auth-form="email" class="account-form"><label>Nuevo correo<input type="email" name="email" required maxlength="254" autocomplete="email"/></label><PasswordField name="currentPassword" id="email-password" label="Contraseña actual"/><button type="submit" class="button outline">Enviar confirmación</button><p data-auth-status class="form-status" role="status"></p></form></section></div><script src="../../scripts/accounts.ts"></script></AdminLayout>
