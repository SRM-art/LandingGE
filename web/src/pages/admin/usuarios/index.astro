---
import AdminLayout from '../../../layouts/AdminLayout.astro';import Reauthenticate from '../../../components/Reauthenticate.astro';import {users} from '../../../server/auth';
const rows=users(Astro.locals.user!);const states:Record<string,string>={pending:'Invitación pendiente',active:'Activa',disabled:'Desactivada'};
---
<AdminLayout title="Usuarios"><div class="admin-heading"><div><p class="eyebrow">TU EQUIPO</p><h1>Usuarios y accesos.</h1><p>Controla quién administra el sitio y revisa sus sesiones.</p></div><a class="button outline" href="/admin/correo-local">Buzón de prueba ↗</a></div><div class="admin-grid"><section class="panel"><h2>Invitar a un administrador</h2><p class="hint">Podrá gestionar productos, proyectos y contenidos. Solo el propietario administra usuarios.</p><form data-auth-form="invite" class="account-form"><label>Correo<input type="email" name="email" required maxlength="254" autocomplete="off"/></label><button type="submit" class="button primary">Crear invitación →</button><p data-auth-status class="form-status" role="status"></p></form></section><Reauthenticate/></div><section class="panel table-panel"><div class="table-scroll"><table class="admin-table"><thead><tr><th>Cuenta</th><th>Rol</th><th>Estado</th><th>Sesiones</th><th>Acciones</th></tr></thead><tbody>{rows.map(u=><tr><td><strong>{u.email}</strong></td><td>{u.role==='owner'?'Propietario':'Administrador'}</td><td><span class:list={['badge',u.state==='active'?'published':u.state==='pending'?'draft':'hidden']}>{states[u.state]}</span></td><td><a class="text-link" href={`/admin/usuarios/${u.id}/sesiones`}>{u.sessions} · Ver sesiones</a></td><td><div class="account-actions">{u.role!=='owner'&&<><form data-auth-form={u.state==='disabled'?'restore':'disable'} data-confirm={u.state==='disabled'?'¿Restaurar esta cuenta? Recibirá una nueva invitación para establecer su contraseña.':'¿Desactivar esta cuenta? Se cerrarán sus sesiones y conservará su historial.'}><input type="hidden" name="id" value={u.id}/><button class="text-link" type="submit">{u.state==='disabled'?'Restaurar':'Desactivar'}</button><p data-auth-status class="form-status" role="status"></p></form>{u.state==='pending'&&<form data-auth-form="resend"><input type="hidden" name="id" value={u.id}/><button class="text-link" type="submit">Reenviar invitación</button><p data-auth-status class="form-status" role="status"></p></form>}</>}{u.role==='owner'&&<span class="hint">Cuenta protegida</span>}</div></td></tr>)}</tbody></table></div></section><p class="hint">Desactivar conserva la cuenta y su historial. Restaurarla exige una nueva activación; los enlaces y las sesiones anteriores no vuelven a funcionar.</p><script src="../../../scripts/accounts.ts"></script></AdminLayout>
