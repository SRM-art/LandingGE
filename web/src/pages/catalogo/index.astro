---
import CatalogBranches from '../../components/CatalogBranches.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categoryPath } from '../../domain/category-tree';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { categories, products } from '../../server/db';

const incoming = Astro.url.searchParams;
const q = new URLSearchParams();
const search = incoming.get('q')?.trim().slice(0, 100);
if (search) q.set('q', search);
if (incoming.get('discount') === '1') q.set('discount', '1');
if (incoming.get('sort') === 'name') q.set('sort', 'name');
const branches = (await categories());
const requestedBranch = incoming.get('rama') || incoming.get('category')
  || (incoming.has('group') ? 'catalogo-' + incoming.get('group') : null);
const selected = branches.find(branch => branch.code === requestedBranch);
const selectedPath = categoryPath(branches, selected?.id ?? null);
if (selected) q.set('rama', selected.code);

function catalogLink(code?: string, page?: number, clear = false) {
  const params = clear ? new URLSearchParams() : new URLSearchParams(q);
  params.delete('rama');
  if (code) params.set('rama', code);
  if (page && page > 1) params.set('page', String(page));
  return '/catalogo' + (params.size ? '?' + params : '');
}

const rows = (await products(q));
const pageSize = 20;
const pageCount = Math.max(1, Math.ceil(rows.length / pageSize));
const requestedPage = Number(incoming.get('page'));
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? Math.min(pageCount, requestedPage) : 1;
const visible = rows.slice((page - 1) * pageSize, page * pageSize);
---
<SiteLayout title="Catálogo">
  <section class="page-intro">
    <p class="eyebrow">EXPLORA NUESTRA SELECCIÓN</p>
    <h1>Encuentra la esencia<br/><em>de tu próximo espacio.</em></h1>
    <p>Pisos, texturas y complementos que dan forma a tus ideas.</p>
  </section>
  <section class="section catalog-browse">
    <aside class="catalog-sidebar">
      <details open>
        <summary>Categorías</summary>
        <nav aria-label="Categorías del catálogo">
          <a class="all-categories" href={catalogLink()} aria-current={!selected ? 'page' : undefined}>Todos los productos</a>
          <CatalogBranches categories={branches} selectedPath={selectedPath} linkTo={catalogLink}/>
        </nav>
      </details>
    </aside>
    <div class="catalog-results">
      {selected && <nav class="category-path" aria-label="Ruta de la categoría">
        <a href={catalogLink()}>Catálogo</a>
        {selectedPath.map(item => <><span aria-hidden="true">/</span>{item.id === selected.id
          ? <span aria-current="page">{item.name}</span> : <a href={catalogLink(item.code)}>{item.name}</a>}</>)}
      </nav>}
      <form class="catalog-tools" action="/catalogo">
        {selected && <input type="hidden" name="rama" value={selected.code}/>}
        <label>Buscar<input name="q" value={search ?? ''} placeholder="Nombre o referencia" maxlength="100"/></label>
        <label>Ordenar por<select name="sort"><option value="featured">Destacados</option><option value="name" selected={q.get('sort') === 'name'}>Nombre</option></select></label>
        <label class="catalog-discount"><input type="checkbox" name="discount" value="1" checked={q.has('discount')}/>Solo ofertas</label>
        <button class="button primary" type="submit">Aplicar</button>
        {(search || q.has('discount') || q.has('sort')) && <a href={catalogLink(selected?.code, 1, true)}>Limpiar filtros</a>}
      </form>
      <div class="results-heading"><p><strong>{rows.length}</strong> {rows.length === 1 ? 'producto' : 'productos'}</p><span>Precios finales en COP</span></div>
      <div class="product-grid">{visible.map(p => <ProductCard p={p}/>)}</div>
      {!rows.length && <div class="empty-state"><h2>No encontramos productos.</h2><p>Prueba con otra categoría o cambia la búsqueda.</p><a href="/catalogo" class="button primary">Ver todo el catálogo</a></div>}
      {pageCount > 1 && <nav class="pagination" aria-label="Páginas">{Array.from({length: pageCount}, (_, index) => <a href={catalogLink(selected?.code, index + 1)} aria-current={page === index + 1 ? 'page' : undefined}>{index + 1}</a>)}</nav>}
    </div>
  </section>
</SiteLayout>
<style>
  .catalog-browse { padding-block-start: 34px; display: grid; grid-template-columns: minmax(178px, 224px) minmax(0, 1fr); gap: clamp(20px, 3vw, 45px); align-items: start; }
  .catalog-sidebar { border: 1px solid var(--line); border-radius: 7px; padding: 14px; }
  .catalog-sidebar summary { padding: 4px 10px 8px; cursor: pointer; font-size: 17px; font-weight: 600; }
  .all-categories { display: block; border-radius: 5px; padding: 9px 10px; font-size: 15px; }
  .all-categories:hover { background: var(--paper); }
  .all-categories[aria-current] { background: var(--navy); color: white; }
  .category-path { display: flex; flex-wrap: wrap; gap: 8px; color: var(--muted); font-size: 14px; }
  .category-path a { text-decoration: underline; }
  .catalog-tools { display: flex; align-items: end; flex-wrap: wrap; gap: 12px 18px; margin: 0 0 22px; }
  .category-path + .catalog-tools { margin-top: 15px; }
  .catalog-tools > label:first-of-type { flex: 1 1 220px; }
  .catalog-tools .button { min-height: 43px; }
  .catalog-tools a { text-decoration: underline; padding: 10px 0; font-size: 14px; }
  .catalog-discount { display: flex; align-items: center; gap: 8px; min-height: 43px; cursor: pointer; }
  .catalog-discount input { width: 16px; min-height: 16px; margin: 0; accent-color: var(--navy); }
  .catalog-results .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 1050px) { .catalog-results .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .catalog-browse { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) { .catalog-tools > label:first-of-type { flex-basis: 100%; } .catalog-tools { gap: 10px 12px; } }
</style>
