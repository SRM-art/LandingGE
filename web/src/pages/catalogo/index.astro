---
import SiteLayout from '../../layouts/SiteLayout.astro';import ProductCard from '../../components/ProductCard.astro';import Icon from '../../components/Icon.astro';import {products,options,all} from '../../server/db';
const q = Astro.url.searchParams;
const rows = products(q);
const o = options();
const pageSize = 20;
const pageCount = Math.max(1, Math.ceil(rows.length / pageSize));
const requestedPage = Number(q.get('page'));
const validPage = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const page = Math.min(pageCount, validPage);
const visible = rows.slice((page - 1) * pageSize, page * pageSize);
const comparable=!!q.get('category')&&!!q.get('presentation');const sizes=all("SELECT DISTINCT length_mm || 'x' || width_mm AS value FROM technical_sheet WHERE length_mm!='' AND width_mm!=''");
---
<SiteLayout title="Catálogo"><section class="page-intro"><p class="eyebrow">EXPLORA NUESTRA SELECCIÓN</p><h1>Encuentra la esencia<br/><em>de tu próximo espacio.</em></h1><p>Pisos, texturas y complementos que dan forma a tus ideas.</p></section><section class="catalog-shell section"><button class="button outline mobile-filter" data-filter-toggle>Mostrar filtros</button><aside class="filters"><form action="/catalogo"><div class="filter-heading"><h2>Filtrar por</h2><a href="/catalogo">Limpiar</a></div><label>Buscar<input name="q" value={q.get('q')||''} placeholder="Nombre o referencia"/></label><label>Categoría<select name="category"><option value="">Todos los productos</option>{o.categories.map(c=><option value={c.code} selected={q.get('category')===c.code}>{c.name}</option>)}</select></label><label>Presentación<select name="presentation"><option value="">Todas</option>{o.presentations.map(p=><option value={p.code} selected={q.get('presentation')===p.code}>{p.name}</option>)}</select></label>{[['color','Color'],['finish','Acabado'],['use','Uso'],['area','Área']].map(([type,label])=><label>{label}<select name={type}><option value="">Todos</option>{o.facets.filter(f=>f.type===type).map(f=><option value={f.id} selected={q.get(type)===String(f.id)}>{f.name}</option>)}</select></label>)}<label>Formato (mm)<select name="size"><option value="">Todos</option>{sizes.map(s=><option selected={q.get('size')===s.value} value={s.value}>{s.value.replace('x',' × ')}</option>)}</select></label><fieldset disabled={!comparable}><legend>Precio final por presentación</legend><div class="field-pair"><input aria-label="Precio mínimo" name="min" type="number" min="0" placeholder="Desde" value={q.get('min')||''}/><input aria-label="Precio máximo" name="max" type="number" min="0" placeholder="Hasta" value={q.get('max')||''}/></div></fieldset>{!comparable&&<p class="hint">Selecciona categoría y presentación, y aplica los filtros para comparar precios equivalentes.</p>}<label>Ordenar por<select name="sort"><option value="featured">Destacados</option><option value="name" selected={q.get('sort')==='name'}>Nombre</option>{comparable&&<><option value="price-up" selected={q.get('sort')==='price-up'}>Menor precio</option><option value="price-down" selected={q.get('sort')==='price-down'}>Mayor precio</option></>}</select></label><button class="button primary full">Aplicar filtros<Icon name="arrow" size={18}/></button></form></aside><div class="catalog-results"><div class="results-heading"><p><strong>{rows.length}</strong> productos {q.get('q')&&<>para “{q.get('q')}”</>}</p><span>Precios finales en COP</span></div><div class="product-grid">{visible.map(p=><ProductCard p={p}/>)}</div>{!rows.length&&<div class="empty-state"><h2>Aún no encontramos esa combinación.</h2><p>Prueba con otra referencia o amplía los filtros.</p><a href="/catalogo" class="button primary">Ver todo el catálogo</a></div>}{pageCount>1&&<nav class="pagination" aria-label="Páginas">{Array.from({length:pageCount},(_,i)=>{const params=new URLSearchParams(q);params.set('page',String(i+1));return <a href={'?'+params} aria-current={page===i+1?'page':undefined}>{i+1}</a>})}</nav>}</div></section></SiteLayout>
