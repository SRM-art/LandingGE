---
import {adhesiveMaterials,environments,specializedSelects,tones} from '../../domain/product-attributes';
import {categoryPath} from '../../domain/category-tree';
import FloorCalculator from '../../components/FloorCalculator.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';import Gallery from '../../components/Gallery.astro';import WhatsApp from '../../components/WhatsApp.astro';import {categories,product} from '../../server/db';import {money,equivalent,quantity,productPricing} from '../../domain/pricing';
const p=(await product(Astro.params.slug!));
if(!p)Astro.response.status=404;
else if(Astro.params.slug!==p.slug)return Astro.redirect('/catalogo/'+p.slug,301);
const path = p ? categoryPath((await categories()), p.category_id) : [];
const tone = p?.tone ? tones[p.tone as keyof typeof tones] : undefined;
const environment = p?.environment ? environments[p.environment as keyof typeof environments] : undefined;
const materialCodes: string[] = JSON.parse(p?.adhesive_materials ?? "[]");
const materials = materialCodes.map(code=>adhesiveMaterials[code as keyof typeof adhesiveMaterials]).filter(Boolean);
const technicalLabels = specializedSelects.filter(({key})=>p?.[key])
  .map(({key,label,options})=>({label, value:(options as Record<string,string>)[p[key]]}));
const pricing = p ? productPricing(p) : null;
const measure=['M2','ML','KG'].map(code=>p?.measures.find((m:any)=>m.unit_code===code)).find(Boolean);const eq=measure?equivalent(pricing!.final!,measure.amount):null;
const cover=p?.images[0] ? '/media/'+p.images[0].id+'/1600' : undefined;
const origin=Astro.url.origin;
const structuredData=p && pricing?.final!=null ? {
  '@context':'https://schema.org',
  '@type':'Product',
  name:p.name,
  sku:p.sku,
  description:p.description || p.name,
  category:p.category,
  ...(cover ? { image:new URL(cover,origin).href } : {}),
  offers:{'@type':'Offer',price:pricing.final/100,priceCurrency:'COP',url:new URL('/catalogo/'+p.slug,origin).href},
} : undefined;
---
<SiteLayout title={p?.name||'Producto no disponible'} description={p ? p.name+' en Gestión Esencial. '+(p.description||p.category) : 'Explora otras referencias disponibles en el catálogo.'} image={cover} structuredData={structuredData} noindex={!p}>{p?<div class="section detail-section"><nav class="breadcrumbs"><a href="/">Inicio</a><span>/</span><a href="/catalogo">Catálogo</a>{path.map(branch=><><span>/</span><a href={'/catalogo?rama='+branch.code}>{branch.name}</a></>)}<span>/</span><span>{p.name}</span></nav><div class="product-detail"><Gallery images={p.images} name={p.name}/><div class="product-info"><p class="eyebrow">{p.category}</p><h1>{p.name}</h1><p class="sku">Referencia: {p.sku}</p><div class="price-block">{pricing!.hasDiscount&&<div class="detail-discount"><span class="price-before">Antes <del>{money(pricing!.regular!)}</del></span><span class="detail-discount-label">{pricing!.discountLabel}% de descuento</span></div>}<strong>{money(pricing!.final!)}</strong><span> / {p.unit_name}{p.presentation_code==='SACO'?' (saco)':p.presentation_code==='BOLSA'?' (bolsa)':''}</span><p>Precio final en COP</p>{measure&&<div class="equivalent"><span>{quantity(measure.amount)} {measure.symbol} por {p.presentation.toLowerCase()}</span><b>{eq?money(eq):'—'} / {measure.symbol}</b><small>Valor equivalente informativo. Venta por {p.unit_name} completa.</small></div>}</div><p class="product-description">{p.description}</p><WhatsApp label="Me interesa este producto" message={'Hola, estoy interesado en '+p.name+' (referencia '+p.sku+') y me interesa más información.'}/><p class="hint">Confirma disponibilidad y detalles con nuestro equipo.</p><div class="product-tags">{tone&&<span>Tono {tone.toLowerCase()}</span>}{environment&&<span>Ambiente: {environment.toLowerCase()}</span>}{p.slip_resistant===1&&<span>Antideslizante</span>}{technicalLabels.map(({label,value})=><span>{label}: {value}</span>)}{materials.length>0&&<span>Materiales compatibles: {materials.join(", ")}</span>}{p.overlay===1&&<span>Sobre baldosa existente</span>}{p.facets.filter((f:any)=>f.name!=='Antideslizante').map((f:any)=><span>{f.name}</span>)}</div><FloorCalculator p={p}/></div></div>{p.projects.length>0&&<div class="product-information"><details><summary>Presente en estos proyectos</summary><p>{p.projects.map((x:any)=>x.name).join(" · ")}</p><small>Referencias de aplicación del material.</small></details></div>}</div>:<section class="empty-state section"><h1>Este producto no está disponible.</h1><p>Descubre otras opciones de nuestro catálogo.</p><a class="button primary" href="/catalogo">Explorar productos</a></section>}</SiteLayout>
