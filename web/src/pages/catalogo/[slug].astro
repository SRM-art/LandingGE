---
import SiteLayout from '../../layouts/SiteLayout.astro';import Gallery from '../../components/Gallery.astro';import WhatsApp from '../../components/WhatsApp.astro';import {product} from '../../server/db';import {money,equivalent,quantity} from '../../domain/pricing';
const p=product(Astro.params.slug!);if(!p)Astro.response.status=404;
const measure=['M2','ML','KG'].map(code=>p?.measures.find((m:any)=>m.unit_code===code)).find(Boolean);const eq=measure?equivalent(p.price_cents,measure.amount):null;
---
<SiteLayout title={p?.name||'Producto no disponible'}>{p?<div class="section detail-section"><nav class="breadcrumbs"><a href="/">Inicio</a><span>/</span><a href="/catalogo">Catálogo</a><span>/</span><span>{p.name}</span></nav><div class="product-detail"><Gallery images={p.images} name={p.name}/><div class="product-info"><p class="eyebrow">{p.category}</p><h1>{p.name}</h1><p class="sku">Referencia: {p.sku}</p><div class="price-block"><strong>{money(p.price_cents)}</strong><span> / {p.unit_name}{p.presentation_code==='SACO'?' (saco)':p.presentation_code==='BOLSA'?' (bolsa)':''}</span><p>Precio final en COP</p>{measure&&<div class="equivalent"><span>{quantity(measure.amount)} {measure.symbol} por {p.presentation.toLowerCase()}</span><b>{eq?money(eq):'—'} / {measure.symbol}</b><small>Valor equivalente informativo. Venta por {p.unit_name} completa.</small></div>}</div><p class="product-description">{p.description}</p><WhatsApp label="Me interesa este producto" message={'Hola, estoy interesado en '+p.name+' (referencia '+p.sku+') y me interesa más información.'}/><p class="hint">Confirma disponibilidad y detalles con nuestro equipo.</p><div class="product-tags">{p.facets.map((f:any)=><span>{f.name}</span>)}</div></div></div><div class="product-information"><div><p class="eyebrow">CONOCE CADA DETALLE</p><h2>Información <em>del producto.</em></h2></div><div><details open><summary>Ficha técnica</summary><dl class="spec-table"><div><dt>Presentación</dt><dd>{p.presentation}</dd></div>{p.measures.map((m:any)=><div><dt>{m.name} por {p.presentation.toLowerCase()}</dt><dd>{quantity(m.amount)} {m.symbol}</dd></div>)}{[['length_mm','Largo (mm)'],['width_mm','Ancho (mm)'],['thickness_mm','Espesor (mm)'],['warranty','Garantía']].map(([key,label])=>p.sheet[key]&&<div><dt>{label}</dt><dd>{p.sheet[key]}</dd></div>)}</dl></details><details><summary>Instalación y cuidado</summary><p>{p.sheet.recommendations||'Consulta estas indicaciones con nuestro equipo.'}</p></details><details><summary>Características</summary><p>{p.sheet.advantages||p.description}</p></details>{p.projects.length>0&&<details><summary>Presente en estos proyectos</summary><p>{p.projects.map((x:any)=>x.name).join(' · ')}</p><small>Referencias de aplicación del material.</small></details>}</div></div></div>:<section class="empty-state section"><h1>Este producto no está disponible.</h1><p>Descubre otras opciones de nuestro catálogo.</p><a class="button primary" href="/catalogo">Explorar productos</a></section>}</SiteLayout>

