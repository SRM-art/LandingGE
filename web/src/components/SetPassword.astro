---
import AccessLayout from '../layouts/AccessLayout.astro';import PasswordField from './PasswordField.astro';
const {activate=false}=Astro.props;const token=Astro.url.searchParams.get('token')||'';
---
<AccessLayout title={activate?'Activar cuenta':'Nueva contraseña'}><h1>{activate?'Un nuevo comienzo.':'Elige tu nueva contraseña.'}</h1><p>{activate?'Activa tu cuenta para gestionar el catálogo y los proyectos.':'Al guardar se cerrarán todas las sesiones de tu cuenta.'}</p>{/^[a-f0-9]{64}$/.test(token)?<form data-auth-form={activate?'activate':'reset'} class="account-form"><input type="hidden" name="token" value={token}/><PasswordField fresh/><PasswordField name="confirmation" label="Confirmar contraseña" fresh/><button type="submit" class="button primary full">{activate?'Activar cuenta':'Guardar contraseña'} →</button><p data-auth-status class="form-status" role="status"></p></form>:<div class="notice">Falta un enlace válido. Abre el mensaje más reciente del buzón local.</div>}<a class="text-link" href="/admin/login">Ir al inicio de sesión</a></AccessLayout>
