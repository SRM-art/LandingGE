---
import AccessLayout from '../layouts/AccessLayout.astro';import PasswordField from './PasswordField.astro';
const {activate=false}=Astro.props;const token=Astro.url.searchParams.get('token')||'';
---
<AccessLayout title={activate?'Activar cuenta':'Nueva contraseña'}><h1>{activate?'Un nuevo comienzo.':'Elige tu nueva contraseña.'}</h1><p>{activate?'Activa tu cuenta para gestionar el catálogo y los proyectos.':'Al guardar se cerrarán todas las sesiones de tu cuenta.'}</p>{/^[a-f0-9]{64}$/.test(token)?<form data-auth-form={activate?'activate':'reset'} class="account-form"><input type="hidden" name="token" value={token}/><PasswordField fresh/><PasswordField name="confirmation" label="Confirmar contraseña" fresh/><div class="form-actions"><button class="button primary" type="submit">{activate?'Activar cuenta':'Guardar contraseña'} →</button><a class="button outline" href="/admin/login">Cancelar</a></div><p data-auth-status class="form-status" role="status"></p></form>:<><div class="notice">Abre el enlace del mensaje más reciente para continuar.</div><a class="text-link" href="/admin/login">Ir al inicio de sesión</a></>}</AccessLayout>
