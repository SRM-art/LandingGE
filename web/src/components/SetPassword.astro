---
import {production} from "#runtime";
import AccessLayout from '../layouts/AccessLayout.astro';import PasswordField from './PasswordField.astro';
const {activate=false}=Astro.props;
const queryToken=production?'':Astro.url.searchParams.get('token')||'';
const token=/^[a-f0-9]{64}$/.test(queryToken)?queryToken:'';
---
<AccessLayout title={activate?'Activar cuenta':'Nueva contraseña'}><h1>{activate?'Un nuevo comienzo.':'Elige tu nueva contraseña.'}</h1><p>{activate?'Activa tu cuenta para gestionar el catálogo y los proyectos.':'Al guardar se cerrarán todas las sesiones de tu cuenta.'}</p><form data-auth-form={activate?'activate':'reset'} class="account-form" hidden={!token}><input type="hidden" name="token" value={token} data-link-token/><PasswordField fresh/><PasswordField name="confirmation" label="Confirmar contraseña" fresh/><div class="form-actions"><button class="button primary" type="submit">{activate?'Activar cuenta':'Guardar contraseña'} →</button><a class="button outline" href="/admin/login">Cancelar</a></div><p data-auth-status class="form-status" role="status"></p></form><div data-link-notice hidden={!!token}><p class="notice">Abre el enlace del mensaje más reciente para continuar.</p><a class="text-link" href="/admin/login">Ir al inicio de sesión</a></div></AccessLayout>
