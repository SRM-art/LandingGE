---
import {products,projects} from '../server/db';import {money} from '../domain/pricing';const {kind}=Astro.props;const isProduct=kind==='product';const route=isProduct?'productos':'proyectos';const hidden=Astro.url.searchParams.get('view')==='hidden';const q=Astro.url.searchParams.get('q')||'';let rows=isProduct?products(Astro.url.searchParams,true):projects(true,hidden);if(!isProduct&&q)rows=rows.filter(p=>(p.name+' '+p.sku).toLowerCase().includes(q.toLowerCase()));
---
<div class="admin-heading"><div><p class="eyebrow">GESTIONA TU CATÁLOGO</p><h1>{isProduct?'Productos':'Proyectos'}</h1><p>{isProduct?'Referencias, precios, imágenes y especificaciones.':'Espacios que conectan a tus clientes con los materiales.'}</p></div><a class="button primary" href={'/admin/'+route+'/nuevo'}>+ Agregar {isProduct?'producto':'proyecto'}</a></div><div class="list-tools"><nav class="tabs"><a class:list={{active:!hidden}} href={'/admin/'+route}>Activos</a><a class:list={{active:hidden}} href={'/admin/'+route+'?view=hidden'}>Ocultos</a></nav><form><input name="q" placeholder="Buscar nombre o referencia" value={q} aria-label="Buscar"/>{hidden&&<input type="hidden" name="view" value="hidden"/>}<button class="button outline">Buscar</button></form></div>{hidden&&<div class="notice">Estos registros están ocultos para los visitantes. Puedes editarlos o restaurarlos como borradores.</div>}<section class="panel table-panel"><div class="table-scroll"><table class="admin-table"><thead><tr><th>{isProduct?'Producto':'Proyecto'}</th><th>{isProduct?'Categoría / precio':'Ciudad / sector'}</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>{rows.map(p=><tr><td><a class="table-product" href={'/admin/'+route+'/'+p.id}>{p.cover&&<img src={'/media/'+p.cover+'/480'} alt=""/>}<div><strong>{p.name}</strong><span>{p.sku}</span></div></a></td><td>{isProduct?<><span>{p.category}</span><small>{p.price_cents?money(p.price_cents):'Sin precio'} / {p.presentation.toLowerCase()}</small></>:<><span>{p.city}</span><small>{p.sector}</small></>}</td><td><span class:list={['badge',hidden?'hidden':p.state]}>{hidden?'Oculto':p.state==='published'?'Publicado':'Borrador'}</span></td><td><div class="row-actions"><a href={'/admin/'+route+'/'+p.id}>Editar</a>{!hidden&&p.state==='published'&&<a href={'/'+(isProduct?'catalogo':'proyectos')+'/'+p.slug} target="_blank">Ver ↗</a>}<button data-state={hidden?'restore':'hide'} data-kind={kind} data-id={p.id}>{hidden?'Restaurar':'Ocultar'}</button></div></td></tr>)}</tbody></table></div>{!rows.length&&<div class="empty-state"><h2>No hay registros aquí.</h2><p>{hidden?'Los registros que ocultes aparecerán en esta sección.':'Agrega un registro o cambia la búsqueda.'}</p></div>}</section><p class="hint">{rows.length} registros · Ocultar conserva toda la información.</p>
