---
const {name='password',label='Contraseña',fresh=false,id=name}=Astro.props;
---
<label for={id}>{label}</label><div class="password-control"><input type="password" id={id} name={name} required minlength={fresh?15:undefined} maxlength="256" autocomplete={fresh?'new-password':'current-password'}/><button type="button" data-show-password={id} aria-controls={id} aria-pressed="false">Mostrar</button></div>{fresh&&<p class="hint">De 15 a 128 caracteres. Puedes usar una frase con espacios.</p>}
