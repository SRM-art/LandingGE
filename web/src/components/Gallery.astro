---
const {images,name}=Astro.props;
---
<div class="gallery" data-gallery><div class="gallery-thumbs">{images.map((im:any,i:number)=><button data-image={'/media/'+im.id+'/960'} data-alt={im.alt||name} aria-label={'Ver imagen '+(i+1)} aria-pressed={i===0}><img src={'/media/'+im.id+'/480'} alt={im.alt||name} width="100" height="100"/></button>)}</div><div class="gallery-main">{images[0]&&<img data-main-image src={'/media/'+images[0].id+'/960'} alt={images[0].alt||name} width="960" height="960"/>}<span>Imagen de referencia</span></div></div>
